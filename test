            fill="none"
          />
          <path
            v-else
            :d="`M13 ${19 + data.mouthY}a1 1 0 0010 0`"
            :fill="data.faceColor"
          />

          <!-- 雙眼 -->
          <circle :cx="14 + data.eyeX" :cy="14 + data.eyeY" r="1.6" :fill="data.faceColor" />
          <circle :cx="22 + data.eyeX" :cy="14 + data.eyeY" r="1.6" :fill="data.faceColor" />
        </g>
      </g>
